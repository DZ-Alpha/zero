# 로컬 개발에서만 /docs·/redoc·/openapi.json을 켠다 - 스테이징/운영은 반드시
# false(기본값, 코드 미설정)로 둬야 한다(2026-08-01 스테이징 API 문서 노출 이슈).
ENABLE_API_DOCS=true

# Must be identical to login-service's JWT_SECRET — community-service only
# verifies tokens issued by login-service, it never issues its own.
JWT_SECRET=dev-secret-change-me
# Must match login-service's JWT_EXPIRE_MINUTES (sliding-session refresh).
JWT_EXPIRE_MINUTES=180

FRONTEND_URL=http://localhost:3000

# Same Postgres instance as login-service/main-service. This service owns and
# self-migrates its own `community` schema (see app/main.py) — unlike the
# `service` schema, which is provisioned by the data team.
POSTGRES_HOST=<db-host>
POSTGRES_PORT=5432
POSTGRES_DB=test_db
POSTGRES_USER=여기에 입력
POSTGRES_PASSWORD=여기에 입력

# 얌로그(rooms) 연동용 — Diet Service 내부 조회 엔드포인트 서버간 호출.
DIET_SERVICE_URL=http://diet-service:8020
# diet-service의 동일 이름 값과 일치해야 한다.
INTERNAL_SERVICE_SECRET=

# 사진을 안 쓰는 호출부(방 요약/멤버 목록/주간 랭킹/배지)에서 diet-service를
# includePhotos=false로 부를지 여부. false로 두면 예전처럼 모든 호출이 사진
# 서명 URL을 받아온다 — 부하테스트에서 이 값만 뒤집어 A/B로 rps·p95를 재려고
# 남겨둔 스위치다. 어느 조건이었는지는 diet-service 접속 로그의
# includePhotos 쿼리로 확인할 수 있다.
ROOMS_SKIP_UNUSED_PHOTOS=true
