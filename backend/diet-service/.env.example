# 로컬 개발에서만 /docs·/redoc·/openapi.json을 켠다 - 스테이징/운영은 반드시
# false(기본값, 코드 미설정)로 둬야 한다(2026-08-01 스테이징 API 문서 노출 이슈).
ENABLE_API_DOCS=true

POSTGRES_HOST=<db-host>
POSTGRES_PORT=5432
POSTGRES_DB=test_db
POSTGRES_USER=여기에 입력
POSTGRES_PASSWORD=여기에 입력

FRONTEND_URL=http://localhost:3000

JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
# Must match login-service's JWT_EXPIRE_MINUTES (sliding-session refresh).
JWT_EXPIRE_MINUTES=180

# Product Service base URL (대체 상품 추천 RC-0105 등)
PRODUCT_SERVICE_URL=http://localhost:8016

# zero-db 이벤트 파이프라인(Kafka/MinIO/Vision worker) 연동용. 비어있으면
# 업로드 엔드포인트는 501을 반환한다.
MINIO_ENDPOINT=http://10.10.20.10:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=diet-photos
# 얌로그 사진 조회용 presigned URL은 MINIO_ENDPOINT(내부 주소)로만 서명한다.
# 브라우저에는 이 원본 URL을 절대 내려주지 않고 경로+쿼리만 "/b" 상대경로로
# 내려준다 - frontend의 MINIO_URL(frontend/.env.example)이 이 값과 반드시
# 같아야, 프론트의 app/b/[...path]/route.ts가 경로를 안 건드리고 그대로
# MinIO에 중계할 수 있다(SigV4 서명은 경로 전체를 포함해서, 중간에 한 글자만
# 바뀌어도 SignatureDoesNotMatch가 난다 - 실사용 중 재현된 버그).

# worker가 diet.photo.completed/diet.photo.failed를 발행하는 Kafka 브로커
# (콤마 구분 가능). 비어있으면 consumer를 시작하지 않는다 — 개발팀 요청서
# 정정 1(2026-07-20), HTTP callback 폐기 + Kafka consumer로 전환.
KAFKA_BROKERS=
KAFKA_CONSUMER_GROUP=diet-service

# 얌로그(rooms) 연동용 — community-service가 GET /diet/internal/meal-records를
# 호출할 때, 그리고 이 서비스가 POST /rooms/internal/meal-recorded(식단 기록
# 완료 시 방 스레드 즉시 생성 알림)를 호출할 때 양쪽이 같이 쓰는 공유 시크릿.
# community-service의 동일 이름 값과 일치해야 하고, 비워두면 두 엔드포인트
# 모두 항상 403을 반환한다.
INTERNAL_SERVICE_SECRET=
# 식단 기록 완료 시 얌로그(rooms) 방 스레드를 즉시 만들도록 알리는 대상.
COMMUNITY_SERVICE_URL=http://community-service:8012
