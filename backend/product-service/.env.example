POSTGRES_HOST=<db-host>
POSTGRES_PORT=5432
POSTGRES_DB=test_db
POSTGRES_USER=여기에 입력
POSTGRES_PASSWORD=여기에 입력

FRONTEND_URL=http://localhost:3000

# login-service와 동일한 JWT_SECRET (JWT 검증용)
JWT_SECRET=여기에 입력
JWT_ALGORITHM=HS256
# Must match login-service's JWT_EXPIRE_MINUTES (sliding-session refresh).
JWT_EXPIRE_MINUTES=180

# Claude API (PR-0301~0303 AI 요약용)
ANTHROPIC_API_KEY=여기에 입력

# PR-0301~0303이 어떤 방식으로 Claude를 호출할지 - "anthropic"(다이렉트, 기본값)
# 또는 "bedrock". bedrock으로 바꾸면 위 ANTHROPIC_API_KEY 대신 AWS 자격증명
# (표준 체인 - 아래 두 값 또는 EC2/ECS 인스턴스 role)을 쓴다. 챗봇(backend/ai)
# 이나 diet-service의 Vision 분석과는 무관한 별도 설정.
AI_PROVIDER=anthropic
BEDROCK_MODEL_ID=anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
