# 로컬 개발에서만 /docs·/redoc·/openapi.json을 켠다 - 스테이징/운영은 반드시
# false(기본값, 코드 미설정)로 둬야 한다(2026-08-01 스테이징 API 문서 노출 이슈).
ENABLE_API_DOCS=true

JWT_SECRET=dev-secret-change-me
JWT_EXPIRE_MINUTES=180
FRONTEND_URL=http://localhost:3000
USER_CONTEXT_SOURCE=dummy
LOGIN_SERVICE_URL=http://localhost:8000
MAIN_SERVICE_URL=http://localhost:8010
BEDROCK_REGION=ap-northeast-2
# PoC 선정(2026-07-20): Claude Haiku 4.5. 실제 운영 시 아래 주석 해제.
# BEDROCK_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MODEL_ID=
EMBED_REGION=ap-northeast-2
RAG_ENABLED=false

# 2026-08-04 정정 - 이 주석은 예전에 "챗봇 사진 첨부 분석(product_analysis)만
# Bedrock 대신 Anthropic API를 직접 호출한다"고 적혀 있었으나 실제 구현과
# 어긋난 낡은 설명이었다(코드 확인 결과 app/core/config.py에 anthropic_api_key
# 필드 자체가 없다 - extra="ignore"라 값을 넣어도 조용히 무시됨). 실제로는
# Gemini를 쓴다(app/services/vision_analyzer.py) - 아래 두 값이 진짜 스위치다.
# GEMINI_API_KEY가 비어있으면 사진 분석은 "준비 중" 안내로 폴백한다 -
# 일반 텍스트 질의(BEDROCK_MODEL_ID)는 이 값과 무관하게 별도로 동작한다.
GEMINI_API_KEY=
VISION_PROVIDER=gemini
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=test_db
POSTGRES_USER=
POSTGRES_PASSWORD=

# 챗봇 사진 첨부 원본을 24시간만 보관(감사·재현용, Vision 분석 자체엔 불필요).
# 비어있으면 저장은 건너뛰고 분석 기능은 그대로 동작한다.
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=chat-photos
