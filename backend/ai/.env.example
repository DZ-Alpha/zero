JWT_SECRET=dev-secret-change-me
JWT_EXPIRE_MINUTES=180
FRONTEND_URL=http://localhost:3000
USER_CONTEXT_SOURCE=dummy
LOGIN_SERVICE_URL=http://localhost:8000
MAIN_SERVICE_URL=http://localhost:8010
BEDROCK_REGION=ap-northeast-2
# PoC 선정(2026-07-20): Claude Haiku 4.5. 실제 운영 시 아래 주석 해제.
# BEDROCK_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MODEL_ID=
EMBED_REGION=ap-northeast-2
RAG_ENABLED=false

# 챗봇 사진 첨부 분석(product_analysis) 전용 - 비용 협의(2026-07-26)로 이
# 경로만 Bedrock 대신 Anthropic API를 직접 호출한다(diet-service의
# ANTHROPIC_API_KEY와 같은 키를 써도 된다). 비어있으면 사진 분석은
# "준비 중" 안내로 폴백한다 - 일반 텍스트 질의(BEDROCK_MODEL_ID)는 영향 없음.
ANTHROPIC_API_KEY=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=test_db
POSTGRES_USER=
POSTGRES_PASSWORD=

# 챗봇 사진 첨부 원본을 24시간만 보관(감사·재현용, Vision 분석 자체엔 불필요).
# 비어있으면 저장은 건너뛰고 분석 기능은 그대로 동작한다.
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=chat-photos
