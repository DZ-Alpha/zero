pipeline {
    agent any
    environment {
        REGISTRY = 'harbor.hizero.local'
        PROJECT  = 'dangdang'
        // DAST 스캔 대상 워커 노드 IP 목록. NodePort는 모든 노드에 열리므로 살아있는 아무 노드나 OK.
        // 스페이스 구분: 게이트에서 순회하며 먼저 도달되는 노드로 스캔(노드 1개 장애 견딤).
        NODE_IPS = '192.168.0.71 192.168.0.72 192.168.0.73 192.168.0.75'
    }
    stages {
        // Checkout stage 없음 — Pipeline from SCM이 zero repo 자동 체크아웃.

        stage('Detect Changes') {
            steps {
                script {
                    def all = ['frontend', 'frontend-admin']
                    def prev = env.GIT_PREVIOUS_SUCCESSFUL_COMMIT
                    def changed
                    if (!prev) {
                        echo "이전 성공 빌드 없음 — 전체 빌드"
                        changed = all
                    } else {
                        def prevExists = sh(script: "git cat-file -e ${prev}^{commit} 2>/dev/null && echo yes || echo no",
                                            returnStdout: true).trim()
                        if (prevExists != 'yes') {
                            echo "이전 커밋(${prev})이 히스토리에 없음 — 안전하게 전체 빌드"
                            changed = all
                        } else {
                            def status = sh(script: "git diff --name-only ${prev} HEAD > /tmp/fdiff.txt; echo \$?",
                                            returnStdout: true).trim()
                            if (status != '0') {
                                echo "git diff 실패(exit ${status}) — 안전하게 전체 빌드"
                                changed = all
                            } else {
                                def files = readFile('/tmp/fdiff.txt').trim()
                                def rawLines = files ? files.split('\n') : []
                                // 문서·비코드 파일 제외: 이런 파일만 바뀐 서비스는 빌드/스캔/승격 안 함.
                                // (파일 단위로 거름 — 코드+문서 동시 변경이면 코드가 남아 빌드는 됨)
                                def isDoc = { String f ->
                                    def lower = f.toLowerCase()
                                    // requirements.txt는 .txt지만 의존성 명세(코드/보안) — 문서 제외 안 함.
                                    // (CVE 패치가 requirements.txt만 바꾸는데 문서로 오판돼 빌드 스킵→초록불 방지)
                                    if (lower.tokenize('/').last() == 'requirements.txt') { return false }
                                    lower.endsWith('.md') || lower.endsWith('.txt') ||
                                    lower.endsWith('license') || lower.endsWith('.gitignore')
                                }
                                def lines = rawLines.findAll { !isDoc(it) }
                                def skipped = rawLines.findAll { isDoc(it) }
                                if (skipped) { echo "문서·비코드 변경 무시: ${skipped.join(', ')}" }
                                // 경계매칭: frontend/ 가 frontend-admin/ 오인 방지
                                changed = all.findAll { name -> lines.any { it == name || it.startsWith("${name}/") } }
                            }
                        }
                    }
                    env.CHANGED = changed.join(' ')
                    echo "빌드 대상: ${env.CHANGED ?: '(없음 — 프론트 변경 없음)'}"
                    // 이 job 소관(frontend/frontend-admin) 변경이 없으면 = 백엔드만 바뀐 커밋.
                    // Poll SCM은 경로 필터가 없어 job은 뜨지만, 여기서 NOT_BUILT로 조용히 끝내고
                    // Slack 알림도 스킵한다(post에서 NOOP 플래그 확인). 빌드 correctness는 이미
                    // when 가드로 보장됨 — 이건 노이즈 제거용 표시일 뿐(변경감지 로직은 그대로).
                    if (!env.CHANGED?.trim()) {
                        env.PIPELINE_NOOP = 'true'
                        currentBuild.result = 'NOT_BUILT'
                        echo "프론트 변경 없음 — NOT_BUILT로 종료(알림 스킵)"
                    }
                }
            }
        }

        stage('Build Changed Frontends') {
            when { expression { env.CHANGED?.trim() } }
            steps {
                script {
                    def scannerHome = tool 'sonar-scanner'
                    for (fe in env.CHANGED.split(' ')) {
                        env.FE = fe
                        echo "========== [${fe}] 빌드 시작 =========="

                        // 1) SonarQube (서비스별 projectKey)
                        withSonarQubeEnv('sonarqube') {
                            sh '''
                                "''' + scannerHome + '''/bin/sonar-scanner" \
                                    -Dsonar.projectKey=zero-${FE} \
                                    -Dsonar.projectName=zero-${FE} \
                                    -Dsonar.sources=${FE}
                            '''
                        }
                        timeout(time: 5, unit: 'MINUTES') {
                            waitForQualityGate abortPipeline: true
                        }

                        // 2) docker build + Trivy (Node 빌드는 Dockerfile 멀티스테이지가 내부 수행)
                        sh '''
                            SHA=$(git rev-parse --short HEAD)
                            # [나중에 admin 캡차 켤 때] frontend-admin만:
                            #   turnstile-site-key를 Jenkins Credentials(Secret text)로 등록 후
                            #   docker build --build-arg NEXT_PUBLIC_TURNSTILE_SITE_KEY=$KEY -t fe-${FE}:${SHA} ${FE}
                            docker build -t fe-${FE}:${SHA} ${FE}
                            trivy image --severity CRITICAL,HIGH --exit-code 1 \
                                --ignorefile .trivyignore --scanners vuln --quiet fe-${FE}:${SHA}
                        '''

                        // 3) Harbor push → dangdang/<fe>:<SHA>
                        withCredentials([usernamePassword(credentialsId: 'harbor-cred',
                                usernameVariable: 'HARBOR_USER', passwordVariable: 'HARBOR_TOKEN')]) {
                            sh '''
                                SHA=$(git rev-parse --short HEAD)
                                IMAGE=${REGISTRY}/${PROJECT}/${FE}
                                echo "${HARBOR_TOKEN}" | docker login ${REGISTRY} -u "${HARBOR_USER}" --password-stdin
                                docker tag fe-${FE}:${SHA} ${IMAGE}:${SHA}
                                docker push ${IMAGE}:${SHA}
                                docker logout ${REGISTRY}
                                echo "push 완료: ${IMAGE}:${SHA}"
                            '''
                        }

                        // 4) Update Manifest (charts/<fe>/values-staging.yaml)
                        withCredentials([usernamePassword(credentialsId: 'manifest-git-pat',
                                usernameVariable: 'GIT_USER', passwordVariable: 'GIT_PAT')]) {
                            sh '''
                                set -e
                                SHA=$(git rev-parse --short HEAD)
                                WORK=$(mktemp -d)
                                git clone --depth 1 "https://${GIT_USER}:${GIT_PAT}@github.com/DZ-Alpha/zero-manifests.git" "$WORK"
                                cd "$WORK"
                                git config user.name  "jenkins-ci"
                                git config user.email "ci@hizero.local"
                                yq -i ".image.tag = \\"${SHA}\\"" charts/${FE}/values-staging.yaml
                                if git diff --quiet; then
                                    echo "태그 변경 없음 (${FE} ${SHA}) — skip"
                                else
                                    git commit -am "chore(${FE}): update staging image tag to ${SHA} [skip ci]"
                                    git push origin main
                                    echo "manifest 갱신: ${FE} tag=${SHA}"
                                fi
                                cd / && rm -rf "$WORK"
                            '''
                        }
                        echo "========== [${fe}] 완료 =========="
                    }
                }
            }
        }

        stage('Wait Staging & Promote to Prod') {
            when { expression { env.CHANGED?.trim() } }
            steps {
                script {
                    def SERVER = '192.168.0.68:30080'   // ArgoCD NodePort (HTTP, insecure)
                    // 서비스별 독립 승격: 한 프론트의 승격 실패(staging wait 타임아웃/DAST High/
                    // 매니페스트 push 실패)가 다른 프론트 승격을 막지 않게 catchError로 격리한다.
                    // (백엔드 Jenkinsfile과 동일 패턴. 이전엔 격리가 없어 frontend의 argocd wait
                    // 타임아웃(exit20)이 for 루프를 깨고 frontend-admin 승격을 건너뛰었음.)
                    def promotedFes = []
                    def failedPromoteFes = []
                    withCredentials([string(credentialsId: 'argocd-token', variable: 'ARGOCD_TOKEN')]) {
                        for (fe in env.CHANGED.split(' ')) {
                            env.FE = fe
                            echo "========== [${fe}] staging 대기 후 prod 승격 =========="
                            // catchError: 이 프론트 승격이 실패해도 파이프라인은 계속(빌드는 UNSTABLE 표시).
                            catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE', message: "${fe} 승격 실패") {
                            // 1) staging App(frontend/frontend-admin) Synced+Healthy 대기 (게이트)
                            sh """
                                argocd app wait ${fe} \
                                    --server ${SERVER} --auth-token \$ARGOCD_TOKEN --plaintext \
                                    --sync --health --timeout 300
                            """
                            // ★ DAST 게이트: staging 뜬 것에 ZAP baseline. FAIL(High)이면 prod 승격 차단.
                            def PORT = (fe == 'frontend') ? '30000' : '30001'
                            sh """
                                # 이전 빌드 잔재 제거(zap-out은 workspace라 빌드 간 남음 → 옛 report/log가
                                # 이번 아티팩트로 섞여 진단을 오도한 사례. 매 빌드 깨끗이 시작).
                                rm -rf \$WORKSPACE/zap-out
                                mkdir -p \$WORKSPACE/zap-out && chmod 777 \$WORKSPACE/zap-out
                                # NodePort는 모든 노드에 열리므로, 살아있는(도달되는) 첫 노드를 골라 스캔.
                                # 노드 1개 장애 시 다음 노드로 폴백. 전부 불통이면 서비스 자체 장애로 보고 실패.
                                TARGET_IP=""
                                for ip in ${NODE_IPS}; do
                                    code=\$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 "http://\$ip:${PORT}/" || echo 000)
                                    echo "노드 후보 \$ip:${PORT}/ → \$code"
                                    if [ "\$code" != "000" ]; then TARGET_IP=\$ip; break; fi
                                done
                                if [ -z "\$TARGET_IP" ]; then
                                    echo "DAST 대상 도달 불가 — ${fe}가 어느 노드(${NODE_IPS})로도 안 뜸. 승격 차단"
                                    exit 1
                                fi
                                echo "DAST 스캔 대상 노드: \$TARGET_IP:${PORT} (${fe})"
                                # -I 없음: 0=PASS, 1=FAIL(High, 차단), 2=WARN(통과). 124=timeout.
                                # timeout 360 + ZAP -m 3: staging이 살아있는 백엔드를 보면서 ZAP가
                                #   특정 요청(SSE 등)에 물려 무한 hang된 사례(2026-07-30, 30분+) 방지.
                                #   timeout 초과 시 exit 124 → High(1) 아니므로 통과(그때까지 결과 기준,
                                #   hang이 배포를 막지 않게 함). 차단은 오직 High(1)일 때만.
                                # ★ 좀비 방지(2026-07-31): timeout은 docker CLI만 죽이고 dockerd의
                                #   ZAP 컨테이너는 살아남아(--rm도 CLI 정상종료 때만 작동) 14분+ 좀비로
                                #   생존한 사례 실증. --name으로 이름 붙이고 trap EXIT으로 shell이
                                #   어떤 경로(124/set -e/abort)로 끝나도 반드시 kill.
                                # ★ 진단성(2026-07-31): 지난 hang 때 zap-${fe}.log가 0 B였음 — docker run
                                #   stdout 리다이렉트(>)는 kill 시 통째 소실돼 hang 원인을 못 잡았음.
                                #   trap에서 kill '전에' docker logs로 컨테이너 내부 stdout을 별도 파일
                                #   (zap-${fe}.container.log)로 건져, 다음 hang 원인을 반드시 남긴다.
                                ZAP_NAME=zap-base-${fe}-${BUILD_NUMBER}
                                trap 'if [ "\$(docker inspect -f "{{.State.Running}}" "\$ZAP_NAME" 2>/dev/null)" = "true" ]; then docker logs "\$ZAP_NAME" > \$WORKSPACE/zap-out/zap-${fe}.container.log 2>&1 || true; docker kill "\$ZAP_NAME" 2>/dev/null || true; fi' EXIT
                                timeout 360 docker run --rm --name "\$ZAP_NAME" -v \$WORKSPACE/zap-out:/zap/wrk/:rw \
                                    ghcr.io/zaproxy/zaproxy:stable \
                                    zap-baseline.py -t http://\$TARGET_IP:${PORT} -m 3 \
                                    -r zap-${fe}-report.html > \$WORKSPACE/zap-out/zap-${fe}.log 2>&1 || ZAP_RC=\$?
                                ZAP_RC=\${ZAP_RC:-0}
                                echo "ZAP ${fe} exit=\$ZAP_RC (0=PASS 1=FAIL/High 2=WARN 124=timeout)"
                                tail -25 \$WORKSPACE/zap-out/zap-${fe}.log
                                if [ "\$ZAP_RC" = "124" ]; then
                                    echo "DAST TIMEOUT(6분 초과, hang 방지) — ${fe} 그때까지 High 없어 승격 진행"
                                fi
                                if [ "\$ZAP_RC" = "1" ]; then
                                    echo "DAST FAIL(High) — ${fe} prod 승격 차단"
                                    exit 1
                                fi
                                echo "DAST 통과 — ${fe} 승격 진행"
                            """
                            // 2) 통과 → values-production.yaml tag 승격
                            withCredentials([usernamePassword(credentialsId: 'manifest-git-pat',
                                    usernameVariable: 'GIT_USER', passwordVariable: 'GIT_PAT')]) {
                                sh '''
                                    set -e
                                    SHA=$(git rev-parse --short HEAD)
                                    WORK=$(mktemp -d)
                                    git clone --depth 1 "https://${GIT_USER}:${GIT_PAT}@github.com/DZ-Alpha/zero-manifests.git" "$WORK"
                                    cd "$WORK"
                                    git config user.name  "jenkins-ci"
                                    git config user.email "ci@hizero.local"
                                    yq -i ".image.tag = \\"${SHA}\\"" charts/${FE}/values-production.yaml
                                    if git diff --quiet; then
                                        echo "prod tag 변경 없음 (${FE} ${SHA}) — skip"
                                    else
                                        git commit -am "chore(${FE}): promote to prod tag ${SHA} [skip ci]"
                                        git push origin main
                                        echo "prod 승격: ${FE} tag=${SHA}"
                                    fi
                                    cd / && rm -rf "$WORK"
                                '''
                            }
                            echo "========== [${fe}] prod 승격 완료 =========="
                            promotedFes << fe   // 여기 도달 = 이 프론트 승격 성공
                            } // catchError
                            // catchError 블록 밖: 실패해도 여기 도달. 성공목록에 없으면 실패로 기록.
                            if (!promotedFes.contains(fe)) { failedPromoteFes << fe }
                        }
                    }
                    // Slack이 실제 prod 승격 성공/실패를 정확히 표기하도록 env로 노출.
                    // CHANGED를 덮어쓰지 않는다 — 덮어쓰면 둘 다 실패 시 CHANGED=''가 되어
                    // Slack이 '프론트 변경 없음'(NOOP처럼)으로 오보한다(#90과 같은 종류).
                    env.PROMOTED_FES = promotedFes.join(', ')
                    env.FAILED_PROMOTE_FES = failedPromoteFes.join(', ')
                    echo "prod 승격 성공: ${promotedFes.join(', ') ?: '(없음)'}"
                    if (failedPromoteFes) { echo "prod 승격 실패: ${failedPromoteFes.join(', ')}" }
                }
            }
        }
    }
    post {
        always {
            // ZAP DAST 리포트 보관(htmlpublisher 없어 archive. 빌드 페이지에서 다운로드해서 봄)
            // zap-out은 DAST 스텝이 돌 때만 생성됨 → 있을 때만 archive(스킵 빌드에서 경고 방지)
            // ★ try/catch(2026-07-31): 체크아웃 실패(네트워크/DNS)로 workspace 컨텍스트가
            //   없으면 fileExists가 MissingContextVariableException을 던져 post 블록이
            //   중단→아래 Slack FAILURE 알림도 안 감. 감싸서 예외를 삼키면 알림은 정상 발송.
            script {
                try {
                    if (fileExists('zap-out')) {
                        archiveArtifacts artifacts: 'zap-out/*.html,zap-out/*.log', allowEmptyArchive: true
                    } else {
                        echo 'DAST 미실행(프론트 변경 없음) — 보관할 ZAP 리포트 없음'
                    }
                } catch (err) {
                    echo "ZAP 리포트 보관 스킵(workspace 컨텍스트 없음 추정): ${err.message}"
                }
            }
            // Slack 배포 알림. Incoming Webhook URL을 credential 'slack-webhook'(Secret text)로 주입.
            // 결과별 색: SUCCESS=초록, UNSTABLE=노랑, FAILURE=빨강. curl POST(플러그인 불필요).
            // NOOP(프론트 변경 없이 백엔드 커밋에 딸려 뜬 빌드)이면 알림 스킵 — 노이즈 제거.
            script {
                if (env.PIPELINE_NOOP == 'true') {
                    echo 'Slack 알림 스킵: 프론트 변경 없는 NOOP 빌드'
                    return
                }
                def result = currentBuild.result ?: 'SUCCESS'
                def color = (result == 'SUCCESS') ? 'good' : (result == 'UNSTABLE') ? 'warning' : 'danger'
                def emoji = (result == 'SUCCESS') ? '✅' : (result == 'UNSTABLE') ? '⚠️' : '❌'
                // 승격 성공/실패를 정확히 표기. PROMOTED_FES는 Promote 스테이지가 돌아야 세팅됨
                // → 없으면(Promote 전 실패 등) CHANGED로 폴백해 '대상'만 표기.
                def target
                if (env.PROMOTED_FES != null || env.FAILED_PROMOTE_FES?.trim()) {
                    def okLine   = env.PROMOTED_FES?.trim() ? "배포 완료: ${env.PROMOTED_FES}" : "배포된 프론트 없음"
                    def failPart = env.FAILED_PROMOTE_FES?.trim() ? "\\n실패(제외): ${env.FAILED_PROMOTE_FES}" : ""
                    target = "${okLine}${failPart}"
                } else {
                    target = env.CHANGED?.trim() ? "대상: ${env.CHANGED}" : "프론트 변경 없음"
                }
                def text = "${emoji} 프론트 파이프라인 ${result} (#${env.BUILD_NUMBER})\\n${target}\\n${env.BUILD_URL}"
                // Webhook 미설정 시 알림만 스킵(빌드 결과에 영향 없음).
                try {
                    withCredentials([string(credentialsId: 'slack-webhook', variable: 'SLACK_HOOK')]) {
                        sh """
                            curl -s -X POST -H 'Content-type: application/json' \
                              --data '{"attachments":[{"color":"${color}","text":"${text}"}]}' \
                              "\$SLACK_HOOK" || echo 'Slack 알림 전송 실패(무시)'
                        """
                    }
                } catch (err) {
                    echo "Slack 알림 스킵: credential 'slack-webhook' 없음 또는 오류(${err.message})"
                }
            }
        }
    }
}
